<div class="bg-light py-3 mb-3">
  <div class="container">
    <div class="row">
      <div class="col-md-12 mb-0"><a href="/user/home">My Account</a> <span class="mx-2 mb-0">/</span> <strong class="text-black">My Messages</strong></div>
    </div>
  </div>
</div>

<div class="site-section-sm">
  <div class="container">
    <h2 class="text-black mb-4">My Messages</h2>
    <% if (!messages.length) { %>
      <div class="alert alert-info">No messages.</div>
    <% } else { %>
      <div class="list-group">
      <% for (const msg of messages) { %>
        <div class="list-group-item <%= msg.read ? '' : 'list-group-item-info' %>">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <!-- INSECURE: message text rendered unescaped (stored XSS CWE-79) -->
              <%- msg.text %>
            </div>
            <div class="text-right text-nowrap ml-3">
              <small class="text-muted"><%= msg.sentDate?.toLocaleString?.() %></small>
              <% if (!msg.read) { %><br><span class="badge badge-primary">New</span><% } %>
            </div>
          </div>
        </div>
      <% } %>
      </div>
    <% } %>
  </div>
</div>
