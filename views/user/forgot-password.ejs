<div class="row justify-content-center">
<div class="col-md-6">
<h2>Forgot Password</h2>
<% if (typeof success !== 'undefined' && success) { %><div class="alert alert-success"><%= success %></div><% } %>
<form method="POST" action="/user/forgot-password">
  <div class="form-group"><label>Email Address</label><input type="email" name="email" class="form-control" required></div>
  <button type="submit" class="btn btn-primary">Reset Password</button>
</form>
</div></div>
