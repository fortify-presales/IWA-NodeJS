<div class="bg-light py-3 mb-3">
  <div class="container">
    <div class="row">
      <div class="col-md-12 mb-0"><a href="/user/home">My Account</a> <span class="mx-2 mb-0">/</span> <strong class="text-black">My Profile</strong></div>
    </div>
  </div>
</div>

<div class="site-section-sm">
  <div class="container">
    <div class="row">
      <div class="col-md-8">
        <h2 class="text-black mb-4">My Profile</h2>
        <table class="table">
          <tbody>
            <tr><th scope="row" style="width:30%">Username</th><td><%= user.username %></td></tr>
            <tr><th scope="row">Email</th><td><%= user.email %></td></tr>
            <tr><th scope="row">Name</th><td><%= user.firstName %> <%= user.lastName %></td></tr>
            <tr><th scope="row">Phone</th><td><%= user.phone || '—' %></td></tr>
            <tr><th scope="row">Address</th><td><%= user.address || '—' %></td></tr>
            <tr><th scope="row">City</th><td><%= user.city || '—' %></td></tr>
            <tr><th scope="row">Postcode</th><td><%= user.zip || '—' %></td></tr>
          </tbody>
        </table>
        <div class="mt-3">
          <a href="/user/edit-profile" class="btn btn-primary">Edit Profile</a>
          <a href="/user/change-password" class="btn btn-outline-secondary ml-2">Change Password</a>
          <a href="/user/security" class="btn btn-outline-secondary ml-2">Security</a>
        </div>
      </div>
    </div>
  </div>
</div>
