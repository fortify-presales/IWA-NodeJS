<h2>My Profile</h2>
<p><strong>Username:</strong> <%= user.username %></p>
<p><strong>Email:</strong> <%= user.email %></p>
<p><strong>Name:</strong> <%= user.firstName %> <%= user.lastName %></p>
<p><strong>Phone:</strong> <%= user.phone %></p>
<a href="/user/edit-profile" class="btn btn-primary">Edit Profile</a>
<a href="/user/change-password" class="btn btn-outline-secondary ml-2">Change Password</a>
<a href="/user/security" class="btn btn-outline-secondary ml-2">Security</a>
