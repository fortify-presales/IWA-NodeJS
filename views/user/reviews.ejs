<div class="bg-light py-3 mb-3">
  <div class="container">
    <div class="row">
      <div class="col-md-12 mb-0"><a href="/user/home">My Account</a> <span class="mx-2 mb-0">/</span> <strong class="text-black">My Reviews</strong></div>
    </div>
  </div>
</div>

<div class="site-section-sm">
  <div class="container">
    <h2 class="text-black mb-4">My Reviews</h2>
    <% if (!reviews.length) { %>
      <div class="alert alert-info">No reviews yet.</div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-bordered">
          <thead class="thead-light">
            <tr><th>Product</th><th>Comment</th><th>Rating</th></tr>
          </thead>
          <tbody>
          <% for (const review of reviews) { %>
          <tr>
            <td><%= review.product?.name || 'Unknown' %></td>
            <!-- INSECURE: stored XSS (CWE-79) -->
            <td><%- review.comment %></td>
            <td><%= review.rating %>/5</td>
          </tr>
          <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
