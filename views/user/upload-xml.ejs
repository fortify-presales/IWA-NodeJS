<h2>Upload XML File</h2>
<% if (typeof error !== 'undefined' && error) { %><div class="alert alert-danger"><%= error %></div><% } %>
<!-- INSECURE: XXE (CWE-611) — XML parsed with external entities enabled -->
<form method="POST" action="/user/upload-xml-file" enctype="multipart/form-data">
  <div class="form-group"><label>XML File</label><input type="file" name="file" accept=".xml" class="form-control-file" required></div>
  <button type="submit" class="btn btn-primary">Upload & Parse</button>
</form>
<% if (typeof parsed !== 'undefined' && parsed) { %>
<h5 class="mt-3">Parsed Result:</h5>
<pre class="bg-light p-3"><%= parsed %></pre>
<% } %>
