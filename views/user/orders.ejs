<div class="bg-light py-3 mb-3">
  <div class="container">
    <div class="row">
      <div class="col-md-12 mb-0"><a href="/user/home">My Account</a> <span class="mx-2 mb-0">/</span> <strong class="text-black">My Orders</strong></div>
    </div>
  </div>
</div>

<div class="site-section-sm">
  <div class="container">
    <h2 class="text-black mb-4">My Orders</h2>
    <% if (!orders.length) { %>
      <div class="alert alert-info">No orders yet.</div>
      <a href="/products" class="btn btn-primary">Shop Now</a>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-bordered">
          <thead class="thead-light">
            <tr><th>Order #</th><th>Date</th><th>Amount</th><th>Status</th><th>Actions</th></tr>
          </thead>
          <tbody>
          <% for (const order of orders) { %>
          <tr>
            <td><%= order.orderNum %></td>
            <td><%= order.orderDate?.toLocaleDateString?.() || '' %></td>
            <td><%= currency %> <%= order.amount %></td>
            <td><span class="badge badge-<%= order.shipped ? 'success' : 'warning' %>"><%= order.shipped ? 'Shipped' : 'Pending' %></span></td>
            <td><a href="/user/orders/<%= order.id %>/invoice.pdf" class="btn btn-sm btn-outline-primary">Invoice</a></td>
          </tr>
          <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
