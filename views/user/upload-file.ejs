<div class="bg-light py-3 mb-3">
  <div class="container">
    <div class="row">
      <div class="col-md-12 mb-0"><a href="/user/home">My Account</a> <span class="mx-2 mb-0">/</span> <strong class="text-black">Upload File</strong></div>
    </div>
  </div>
</div>

<div class="site-section-sm">
  <div class="container">
    <div class="row">
      <div class="col-md-8">
        <h2 class="text-black mb-4">Upload File</h2>
        <% if (typeof success !== 'undefined' && success) { %><div class="alert alert-success"><%= success %></div><% } %>
        <!-- INSECURE: unrestricted file upload (CWE-434) -->
        <form method="POST" action="/user/upload-file" enctype="multipart/form-data">
          <div class="form-group"><label>Select File (any type accepted)</label><input type="file" name="file" class="form-control-file" required></div>
          <button type="submit" class="btn btn-primary">Upload</button>
        </form>
      </div>
    </div>
  </div>
</div>
