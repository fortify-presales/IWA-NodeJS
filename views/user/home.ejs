<h2>My Account</h2>
<div class="row">
  <div class="col-md-3"><div class="card text-center p-3"><i class="fas fa-user fa-2x mb-2"></i><br><a href="/user/profile">Profile</a></div></div>
  <div class="col-md-3"><div class="card text-center p-3"><i class="fas fa-shopping-bag fa-2x mb-2"></i><br><a href="/user/orders">Orders</a></div></div>
  <div class="col-md-3"><div class="card text-center p-3"><i class="fas fa-envelope fa-2x mb-2"></i><br><a href="/user/messages">Messages <% if (unreadMessages > 0) { %><span class="badge badge-danger"><%= unreadMessages %></span><% } %></a></div></div>
  <div class="col-md-3"><div class="card text-center p-3"><i class="fas fa-star fa-2x mb-2"></i><br><a href="/user/reviews">Reviews</a></div></div>
</div>
