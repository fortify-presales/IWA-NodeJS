<div class="jumbotron">
  <h1 class="display-4">Welcome to <%= appName %></h1>
  <p class="lead">Your trusted online pharmacy — offering a wide range of medicines, health products, and expert advice.</p>
  <hr>
  <a class="btn btn-primary btn-lg" href="/products">Browse Products</a>
  <a class="btn btn-outline-secondary btn-lg ml-2" href="/prescriptions">Prescriptions</a>
</div>
<div class="row mt-4">
  <div class="col-md-4">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title"><i class="fas fa-pills"></i> Medicines</h5>
        <p>Pain relief, vitamins, first aid and more.</p>
        <a href="/products" class="btn btn-sm btn-primary">Shop Now</a>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title"><i class="fas fa-prescription-bottle"></i> Prescriptions</h5>
        <p>Order your repeat prescriptions online.</p>
        <a href="/prescriptions" class="btn btn-sm btn-primary">Order Now</a>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title"><i class="fas fa-heartbeat"></i> Health Advice</h5>
        <p>Expert advice from our pharmacists.</p>
        <a href="/advice" class="btn btn-sm btn-primary">Get Advice</a>
      </div>
    </div>
  </div>
</div>
