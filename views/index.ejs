<div class="site-blocks-cover" style="background-image: url('/img/home_hero_1a.jpg');">
  <div class="container">
    <div class="row">
      <div class="col-lg-7 mx-auto order-lg-2 py-5">
        <div class="site-block-cover-content text-center">
          <h2 class="sub-title">Local Service, Global Reach</h2>
          <h1 class="main-title">Welcome to <%= appName %></h1>
        </div>
        <div class="jumbotron text-center" style="opacity: 0.9">
          <% if (user) { %>
            <h4>Welcome back to our site, <%= user.username %></h4>
          <% } else { %>
            <h4>Your trusted online pharmacy for medicines and health advice.</h4>
          <% } %>
          <p class="pt-4">
            <% if (!user) { %><a href="/user/register" class="btn p-2 btn-outline-info">Register</a><% } %>
            <a href="/products" class="btn p-2 btn-outline-success">Shop Now</a>
            <a href="/prescriptions" class="btn p-2 btn-outline-info">Prescriptions</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="site-section">
  <div class="container">
    <div class="row align-items-stretch section-overlap">
      <div class="col-md-6 col-lg-4 mb-4 mb-lg-0">
        <div class="banner-wrap bg-primary h-100">
          <a href="/services" class="h-100">
            <h5>Free <br> Shipping</h5>
            <p>
              Fast and secure delivery
              <strong>Available on qualifying orders.</strong>
            </p>
          </a>
        </div>
      </div>
      <div class="col-md-6 col-lg-4 mb-4 mb-lg-0">
        <div class="banner-wrap h-100">
          <a href="/products" class="h-100">
            <h5>Season <br> Sale 50% Off</h5>
            <p>
              Special offers this week
              <strong>Browse discounted products now.</strong>
            </p>
          </a>
        </div>
      </div>
      <div class="col-md-6 col-lg-4 mb-4 mb-lg-0">
        <div class="banner-wrap bg-warning h-100">
          <a href="/advice" class="h-100">
            <h5>Health <br> Advice</h5>
            <p>
              Speak with our pharmacists
              <strong>Get practical guidance today.</strong>
            </p>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<div id="new-products">
  <div class="site-section bg-light">
    <div class="container">
      <div class="row">
        <div class="title-section text-center col-12">
          <h2 class="text-uppercase">New Products</h2>
        </div>
      </div>
      <div id="product-data" class="row"></div>
    </div>
  </div>
</div>

<div class="site-section">
  <div class="container">
    <div class="row">
      <div class="title-section text-center col-12">
        <h2 class="text-uppercase">Testimonials</h2>
      </div>
    </div>
    <div class="row">
      <div class="col-md-12 block-3 products-wrap">
        <div class="nonloop-block-3 no-direction owl-carousel">
          <div class="testimony">
            <blockquote>
              <img src="/img/person_1.jpg" alt="Person" class="img-fluid w-25 mb-4 rounded-circle">
              <p>&ldquo;Excellent service and great value. Highly recommended.&rdquo;</p>
            </blockquote>
            <p>&mdash; Sarah Peters</p>
          </div>
          <div class="testimony">
            <blockquote>
              <img src="/img/person_2.jpg" alt="Person" class="img-fluid w-25 mb-4 rounded-circle">
              <p>&ldquo;Quick delivery and easy online ordering experience.&rdquo;</p>
            </blockquote>
            <p>&mdash; Brent Easter</p>
          </div>
          <div class="testimony">
            <blockquote>
              <img src="/img/person_3.jpg" alt="Person" class="img-fluid w-25 mb-4 rounded-circle">
              <p>&ldquo;Helpful advice and quality products for my family.&rdquo;</p>
            </blockquote>
            <p>&mdash; Lucas Gallione</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

