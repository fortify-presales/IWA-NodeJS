<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — <%= appName %></title>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.3/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.2/css/all.min.css">
  <link rel="stylesheet" href="/css/iwa.css">
</head>
<body>
  <%- include('../fragments/nav') %>
  <div class="container mt-4">
    <% if (locals.flash && locals.flash.success) { %>
      <div class="alert alert-success"><%= locals.flash.success %></div>
    <% } %>
    <% if (locals.flash && locals.flash.error) { %>
      <div class="alert alert-danger"><%= locals.flash.error %></div>
    <% } %>
    <%- body %>
  </div>
  <%- include('../fragments/footer') %>
  <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.3/js/bootstrap.bundle.min.js"></script>
</body>
</html>
