<div class="bg-light py-3 mb-3">
  <div class="container">
    <div class="row">
      <div class="col-md-12 mb-0"><a href="/admin">Admin</a> <span class="mx-2 mb-0">/</span> <strong class="text-black">Backup &amp; Restore</strong></div>
    </div>
  </div>
</div>

<div class="site-section-sm">
  <div class="container">
<h2>Backup & Restore</h2>
<div class="alert alert-danger">⚠️ INSECURE: Zip Slip (CWE-22)</div>
<form method="POST" action="/admin/backup" enctype="multipart/form-data">
  <div class="form-group"><label>Archive (.zip)</label><input type="file" name="archive" accept=".zip" class="form-control-file" required></div>
  <button type="submit" class="btn btn-warning">Extract Archive</button>
</form>
<% if (result) { %><pre class="bg-light p-2 mt-3"><%= result %></pre><% } %>
  </div>
</div>
