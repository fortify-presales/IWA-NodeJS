<div class="bg-light py-3 mb-3">
  <div class="container">
    <div class="row">
      <div class="col-md-12 mb-0"><a href="/admin">Admin</a> <span class="mx-2 mb-0">/</span> <strong class="text-black">Order Management</strong></div>
    </div>
  </div>
</div>

<div class="site-section-sm">
  <div class="container">
<h2>Order Management</h2>
<table class="table table-sm">
  <thead><tr><th>Order #</th><th>User</th><th>Amount</th><th>Status</th></tr></thead>
  <tbody>
  <% for (const o of orders) { %>
  <tr><td><%= o.orderNum %></td><td><%= o.user?.username %></td><td><%= o.amount %></td><td><%= o.shipped ? 'Shipped' : 'Pending' %></td></tr>
  <% } %>
  </tbody>
</table>
  </div>
</div>
