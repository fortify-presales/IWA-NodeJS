<div class="bg-light py-3 mb-3">
  <div class="container">
    <div class="row">
      <div class="col-md-12 mb-0"><a href="/admin">Admin</a> <span class="mx-2 mb-0">/</span> <strong class="text-black">Product Management</strong></div>
    </div>
  </div>
</div>

<div class="site-section-sm">
  <div class="container">
<h2>Product Management</h2>
<table class="table table-sm">
  <thead><tr><th>Code</th><th>Name</th><th>Price</th><th>In Stock</th></tr></thead>
  <tbody>
  <% for (const p of products) { %>
  <tr>
    <td><%= p.code %></td><td><%= p.name %></td><td><%= p.price %></td><td><%= p.inStock ? '✓' : '✗' %></td>
  </tr>
  <% } %>
  </tbody>
</table>
  </div>
</div>
