<h2>Product Management</h2>
<table class="table table-sm">
  <thead><tr><th>Code</th><th>Name</th><th>Price</th><th>In Stock</th></tr></thead>
  <tbody>
  <% for (const p of products) { %>
  <tr>
    <td><%= p.code %></td><td><%= p.name %></td><td><%= p.price %></td><td><%= p.inStock ? '✓' : '✗' %></td>
  </tr>
  <% } %>
  </tbody>
</table>
