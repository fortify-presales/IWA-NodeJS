<div class="bg-light py-3 mb-3">
  <div class="container">
    <div class="row">
      <div class="col-md-12 mb-0"><a href="/admin">Admin</a> <span class="mx-2 mb-0">/</span> <strong class="text-black">Review Management</strong></div>
    </div>
  </div>
</div>

<div class="site-section-sm">
  <div class="container">
<h2>Review Management</h2>
<table class="table table-sm">
  <thead><tr><th>Product</th><th>User</th><th>Comment</th><th>Rating</th></tr></thead>
  <tbody>
  <% for (const r of reviews) { %>
  <tr>
    <td><%= r.product?.name %></td>
    <td><%= r.user?.username %></td>
    <!-- INSECURE: stored XSS (CWE-79) -->
    <td><%- r.comment %></td>
    <td><%= r.rating %></td>
  </tr>
  <% } %>
  </tbody>
</table>
  </div>
</div>
