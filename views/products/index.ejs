<h2>Products</h2>
<form class="form-inline mb-3" method="GET" action="/products">
  <input type="text" name="keywords" class="form-control mr-2" placeholder="Search products..." value="<%= keywords %>">
  <button type="submit" class="btn btn-primary">Search</button>
</form>
<!-- INSECURE: keywords reflected unescaped (XSS CWE-79) -->
<% if (keywords) { %>
  <p>Search results for: <%- keywords %></p>
<% } %>
<div class="row">
  <% for (const product of products) { %>
  <div class="col-md-4 mb-3">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title"><%= product.name %></h5>
        <p class="card-text"><%= product.summary %></p>
        <p><strong><%= currency %> <%= product.onSale ? product.salePrice : product.price %></strong>
          <% if (product.onSale) { %><span class="badge badge-danger">SALE</span><% } %>
        </p>
        <a href="/products/<%= product.id %>" class="btn btn-sm btn-outline-primary">View</a>
        <form method="POST" action="/cart/add" style="display:inline">
          <input type="hidden" name="productId" value="<%= product.id %>">
          <input type="hidden" name="qty" value="1">
          <button type="submit" class="btn btn-sm btn-success">Add to Cart</button>
        </form>
      </div>
    </div>
  </div>
  <% } %>
</div>
<% if (!products.length) { %><div class="alert alert-info">No products found.</div><% } %>
