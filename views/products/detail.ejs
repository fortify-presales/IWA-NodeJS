<div class="bg-light py-3 mb-3">
  <div class="container">
    <div class="row">
      <div class="col-md-12 mb-0"><a href="/products">Shop</a> <span class="mx-2 mb-0">/</span> <strong class="text-black"><%= product.name %></strong></div>
    </div>
  </div>
</div>

<div class="site-section-sm">
  <div class="container">
    <div class="row">
      <div class="col-md-5 mr-auto">
        <div class="border text-center">
          <% const imageSrc = product.image ? (product.image.startsWith('/img/') ? product.image : `/img/products/${product.image}`) : '/img/awaiting-image.png'; %>
          <img src="<%= imageSrc %>" alt="<%= product.name %>" class="img-fluid p-5">
        </div>
        <div class="mt-4">
          <h5>Product Information</h5>
          <table class="table table-sm table-borderless">
            <tr><th scope="row">Code:</th><td><%= product.code %></td></tr>
            <tr><th scope="row">Manufacturer:</th><td>Unknown</td></tr>
            <tr><th scope="row">Contents:</th><td>Unspecified</td></tr>
            <tr><th scope="row">Date First Available:</th><td><%= new Date(product.dateCreated).toLocaleDateString() %></td></tr>
          </table>
        </div>
      </div>

      <div class="col-md-6 item-entry">
        <h2 class="text-black"><%= product.name %></h2>
        <span class="product-rating">
          <% const rating = Math.max(0, Math.min(5, Math.round(product.rating || 0))); %>
          <% for (let i = 0; i < rating; i += 1) { %><i class="fas fa-star" style="color: cornflowerblue"></i><% } %>
          <% for (let i = rating; i < 5; i += 1) { %><i class="fas fa-star" style="color: gray"></i><% } %>
          <span class="product-reviews pl-2"><a href="#reviews-start">Customer Reviews</a>&nbsp;(<%= reviews.length %>)</span>
        </span>

        <h6 class="mt-2">Summary</h6>
        <p><%= product.summary %></p>
        <h6>Description</h6>
        <p><%= product.description %></p>

        <h5 class="price pt-2 pb-4 item-price">
          <% if (product.onSale) { %>
            <del><%= currency %> <%= Number(product.price).toFixed(2) %></del> &ndash;
            <span><%= currency %> <%= Number(product.salePrice).toFixed(2) %></span>
          <% } else { %>
            <span><%= currency %> <%= Number(product.price).toFixed(2) %></span>
          <% } %>
          <% if (product.inStock) { %>
            <span class="badge badge-success">In Stock</span>
          <% } else { %>
            <span class="badge badge-danger">Out of Stock</span>
          <% } %>
        </h5>

        <form method="POST" action="/cart/add" class="cart-add">
          <input type="hidden" name="productId" value="<%= product.id %>">
          <div class="mb-4">
            <div class="input-group mb-3" style="max-width: 180px;">
              <input type="number" name="qty" value="1" min="1" class="form-control text-center">
            </div>
          </div>
          <button type="submit" class="buy-now btn btn-sm height-auto px-4 py-3 btn-primary" <%= product.inStock ? '' : 'disabled' %>>Add To Cart</button>
        </form>
      </div>
    </div>

    <span id="reviews-start"></span>
    <div class="product-reviews rows mt-4">
      <h4>Customer Reviews</h4>
      <% for (const review of reviews) { %>
        <div class="card mb-2">
          <div class="card-body">
            <!-- INSECURE: stored XSS — review comments rendered unescaped (CWE-79) -->
            <%- review.comment %>
            <br><small class="text-muted">Rating: <%= review.rating %>/5 — <%= review.user?.username || 'Anonymous' %></small>
          </div>
        </div>
      <% } %>
      <% if (!reviews.length) { %><p>No reviews yet.</p><% } %>
    </div>
  </div>
</div>
