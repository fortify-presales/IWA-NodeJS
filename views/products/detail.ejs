<div class="row">
  <div class="col-md-8">
    <h2><%= product.name %></h2>
    <p class="text-muted"><%= product.code %></p>
    <p><%= product.description %></p>
    <p><strong>Price: <%= currency %> <%= product.onSale ? product.salePrice : product.price %></strong>
      <% if (product.onSale) { %><span class="badge badge-danger ml-2">ON SALE</span><% } %>
    </p>
    <form method="POST" action="/cart/add">
      <input type="hidden" name="productId" value="<%= product.id %>">
      <div class="form-group">
        <label>Quantity</label>
        <input type="number" name="qty" value="1" min="1" class="form-control" style="width:80px">
      </div>
      <button type="submit" class="btn btn-success">Add to Cart</button>
    </form>
  </div>
</div>
<hr>
<h4>Reviews</h4>
<% for (const review of reviews) { %>
<div class="card mb-2">
  <div class="card-body">
    <!-- INSECURE: stored XSS — review comments rendered unescaped (CWE-79) -->
    <%- review.comment %>
    <br><small class="text-muted">Rating: <%= review.rating %>/5 — <%= review.user?.username || 'Anonymous' %></small>
  </div>
</div>
<% } %>
<% if (!reviews.length) { %><p>No reviews yet.</p><% } %>
