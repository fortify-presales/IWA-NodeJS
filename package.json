    "chart.js": "2.9.4",
    "connect-sqlite3": "^0.9.14",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.18.0",
    "express-validator": "^7.1.0",
    "handlebars": "4.0.11",
    "helmet": "^7.1.0",
    "jsonwebtoken": "8.5.1",
    "lodash": "4.17.15",
    "minimist": "1.2.0",
    "multer": "^1.4.5-lts.1",
    "node-serialize": "0.0.4",
    "nodemailer": "^6.9.13",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.15.0",
    "qrcode": "^1.5.3",
    "reflect-metadata": "^0.2.2",
