{
  "name": "iwa-nodejs",
  "version": "1.0.0",
  "description": "IWA Pharmacy Direct - Intentionally Vulnerable Node.js/TypeScript Application",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:vulns": "vitest run tests/vulnerabilities",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts",
    "db:seed": "tsx src/config/seed.ts",
    "db:reset": "rimraf data/iwa.sqlite && npm run db:seed",
    "sbom": "cyclonedx-npm --output-file etc/sbom.json",
    "docker:build": "docker build -t iwa-nodejs .",
    "docker:run": "docker run -p 8080:8080 iwa-nodejs"
  },
