# IWA Pharmacy Direct - Environment Configuration
# Copy this file to .env and fill in values (keep fake/placeholder values for demo)
NODE_ENV=development
PORT=8888

# Database
DATABASE_URL=./data/iwa.sqlite

# JWT - INSECURE: hardcoded fallback secret in code (CWE-798)
JWT_SECRET=CHANGE_ME_THIS_IS_INSECURE_DO_NOT_USE_IN_PRODUCTION
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_MS=86400000

# Session - INSECURE: predictable secret (CWE-798)
SESSION_SECRET=CHANGE_ME_SESSION_SECRET

# Email (SMTP) - falls back to console transport when not configured
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@iwa-pharmacy.local

# Twilio SMS - no-op stub when unconfigured
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# App
APP_NAME=IWA Pharmacy Direct
APP_VERSION=1.0.0
APP_CURRENCY=GBP
PAGE_SIZE=25
UPLOAD_DIR=./data/uploads
LOG_LEVEL=debug
